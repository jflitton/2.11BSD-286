# Third-party material: fetched by tools/fetch-reference.py from the manifest.
/reference/*
!/reference/MANIFEST

# The installed cross toolchain, build output, disk images, emulator state.
/toolchain/
/obj/
/images/
/vm/

__pycache__/
.DS_Store

# The compiler writes its messages to NAME.err in the directory it runs in.
*.err

# What config keeps of a kernel's Makefile when it writes it again.
/usr/src/sys/*/Makefile.old
