=file wait
# sh /mnt/d/wait FILE N: wait up to a minute for FILE to hold N letters.
n=0
while test `cat $1 2>/dev/null | grep -c '^From '` -lt $2 -a $n -lt 60
do
	sleep 1; n=`expr $n + 1`
done
=file letters
# sh /mnt/d/letters [FILE]: the letters in FILE, or what is read, less
# the lines that differ from run to run.
sed -e 's/^\(From [^ ]*\) .*/\1/' -e '/^Received: /d' -e '/^[ 	]*id AA/d' \
    -e '/^Date: /d' -e '/^Message-Id: /d' $1
=file smtp
# What a client of sendmail's sends it, a line at a time as one that
# waits for each answer does.  sendmail reads what follows MAIL in a
# child, which ends when the letter has been taken, and what was read
# ahead of that is gone with it.
for l in "HELO localhost" "MAIL From:<guest@localhost>" "RCPT To:<root>" \
    "DATA" "Subject: by smtp" "" "smtp-body" "." "QUIT"
do
	echo "$l"; sleep 1
done
=file pop
for l in "USER guest" "PASS Gu3st-pw" "STAT" "RETR 1" "DELE 1" "QUIT"
