# The system calls the kernel's test programs make: tools/mkstubs.py
# turns this into their stubs.  Names beginning with an underscore are
# the calls as the kernel has them, where a C library would put a
# function of its own in front.
_exit=exit	i
fork	-	fork
read	ipi
write	ipi
open	pii
close	i
wait4	ipip
link	pp
unlink	p
chdir	p
mknod	pii
lseek	ili
getpid	-
getppid	-
_sigaction=sigaction	fipp
sync	-
kill	ii
stat	pp
dup	i
_pipe=pipe	p	pair
ioctl	ilp
reboot	i
execve	ppp
fstat	ip
vfork	-	vfork
_brk=sbrk	p
dup2	ii
_select=select	ipppp
_sigreturn=sigreturn	p
mkdir	pi
rmdir	p
segalloc	l	null
segsize	Pl
segfree	P
