=file segs.c
/*
 * More memory than a data segment holds: three segments' worth, got
 * from the system and reached through far pointers.
 */
#include <stdio.h>
#include <errno.h>
#include <segment.h>

#define	PIECE	150000L

long
sum(p, n)
	char __far *p;
	long n;
{
	long i, s = 0;

	for (i = 0; i < n; i++)
		s += *SEGADDR(p, i);
	return (s);
}

main()
{
	char __far *p, __far *q;
	long i;

	p = segalloc(PIECE);
	if (p == 0) {
		perror("segalloc");
		exit(1);
	}
	for (i = 0; i < PIECE; i++)
		*SEGADDR(p, i) = i % 7;
	printf("sum %ld\n", sum(p, PIECE));
	q = segalloc(1000L);
	q[999] = 5;
	if (segsize(q, 60000L) < 0)
		perror("segsize");
	q[59999] = 6;
	printf("%d %d %d\n", q[999], q[1000], q[59999]);
	if (segsize(p, 300000L) < 0)
		printf("segsize: %s\n", strerror(errno));
	if (segfree(q) < 0 || segfree(p) < 0)
		perror("segfree");
	if (segfree(p) < 0)
		printf("segfree: %s\n", strerror(errno));
	exit(0);
}
