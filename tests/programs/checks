=file vmf.c
#include <stdio.h>
#include <vmf.h>

/* 40 segments of 1K through 4 buffers: each written, then read back. */
main()
{
	struct vspace sp;
	struct vseg *s;
	int i, bad = 0;
	long sum = 0;

	if (vminit(4) < 0 || vmopen(&sp, (char *)NULL) < 0) {
		printf("vmf: cannot open\n");
		exit(1);
	}
	for (i = 0; i < 40; i++) {
		s = vmmapseg(&sp, i);
		s->s_winfo[0] = i * 7;
		s->s_winfo[WORDSPERSEG - 1] = -i;
		vmmodify(s);
	}
	for (i = 39; i >= 0; i--) {
		s = vmmapseg(&sp, i);
		if (s->s_winfo[0] != i * 7 || s->s_winfo[WORDSPERSEG - 1] != -i)
			bad++;
		sum += s->s_winfo[0];
	}
	vmclose(&sp);
	printf("vmf: %d bad, sum %ld\n", bad, sum);
	exit(0);
}
