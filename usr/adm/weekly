#! /bin/sh -
# /usr/adm/weekly, which cron runs each Sunday night, mailing root what
# it prints (/etc/crontab).  Upstream's,
# without UUCP, which is not on the system; and it moves a log's older
# copies along only if they are there.
#
PATH=/usr/sbin:/usr/ucb:/bin:/usr/bin
echo "Subject: weekly run output"

echo ""
echo "Rotating messages:"
cd /usr/adm
for i in 2 1 0
do
	test -f messages.$i.Z && mv -f messages.$i.Z messages.`expr $i + 1`.Z
done
mv -f messages   messages.0
compress -f messages.0
cp /dev/null  messages
chmod 644 messages

echo ""
echo "Rotating cron:"
cd /usr/adm
for i in 2 1 0
do
	test -f cron.$i.Z && mv -f cron.$i.Z cron.`expr $i + 1`.Z
done
mv -f cron   cron.0
compress -f cron.0
cp /dev/null  cron
chmod 644 cron

kill -1 `cat /var/run/syslog.pid`
cd /

echo ""
echo "Rebuilding whatis database:"
makewhatis

echo ""
echo "Rebuilding find database:"
su nobody << EOF
	/usr/libexec/find/updatedb
EOF
