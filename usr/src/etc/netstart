#!/bin/sh -
# The network, as /etc/rc.conf describes it; /etc/rc runs this after
# reading that.  From upstream's, without its PDP-11 interfaces, and
# with its SLIP example made rc.conf's.

if [ -n "$hostname" ]
then
	hostname $hostname				>/dev/console 2>&1
fi

ifconfig lo0 inet 127.0.0.1 up				>/dev/console 2>&1

if [ -n "$address" ]
then
	ifconfig $interface inet $address netmask $netmask up >/dev/console 2>&1
	if [ -n "$gateway" ]
	then
		route add default $gateway 1		>/dev/console 2>&1
	fi
fi

# SLIP (Serial Line Internet Protocol): the first address is this end's,
# the second the far end's.
if [ -n "$sladdress" ]
then
	ifconfig sl0 inet $sladdress $sldest			>/dev/console 2>&1
	slattach $slline $slspeed				>/dev/console 2>&1
fi
