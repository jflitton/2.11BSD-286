#!/bin/sh
# /etc/rc for the 286.  init runs it as the system goes multi-user, with
# "autoboot" when the machine has come up by itself, or "fastboot" when
# it comes from single user.  If it fails, init goes to single user.
#
# Upstream's is the PDP-11's (its buses, its network interfaces).  What
# this does of it, it does as that does.  sendmail it starts as
# upstream's rc.local does.

HOME=/; export HOME
PATH=/bin:/sbin:/usr/sbin:/usr/bin; export PATH

if [ "$1" = fastboot ]
then
	echo ''
	echo Fast boot ... skipping disk checks		>/dev/console 2>&1
elif [ "$1" = autoboot ]
then
	echo Automatic boot in progress...		>/dev/console 2>&1
	date						>/dev/console 2>&1
	# The file systems in /etc/fstab, the root alone first.  fsck
	# leaves alone one that was unmounted cleanly; if it has to
	# change the root, which is mounted, the system must start again
	# without writing over what fsck wrote.  The scratch file is for a
	# file system too big for fsck's memory, and so never the root's.
	fsck -p -t /_FSCK_TMP_FILE			>/dev/console 2>&1
	case $? in
	0)
		date					>/dev/console 2>&1
		;;
	2)
		exit 1
		;;
	4)
		reboot -n
		;;
	8)
		echo "Automatic reboot failed... help!"	>/dev/console 2>&1
		exit 1
		;;
	12)
		echo "Reboot interrupted"		>/dev/console 2>&1
		exit 1
		;;
	*)
		echo "Unknown error in reboot"		>/dev/console 2>&1
		exit 1
		;;
	esac
fi

# attempt to rationally recover the passwd file if needed
if [ -s /etc/ptmp ]
then
	echo 'password file may be incorrect' > /dev/console
fi

# What /etc/fstab lists besides the root, which is mounted again with
# the options it gives.
umount -a
mount -a					>/dev/console 2>&1

# Quotas on the file systems fstab says rq for: what each user has is
# counted again, and the kernel then keeps count.
echo -n 'checking quotas:'			>/dev/console 2>&1
quotacheck -a					>/dev/console 2>&1
echo ' done.'					>/dev/console 2>&1
quotaon -a

# The names of the devices, for devname(3), and the kernel's symbols
# that ps needs, so that it need not read them from /unix each time.
dev_mkdb
ps -U						>/dev/console 2>&1

rm -f /etc/nologin
# The locks tip and uucp leave on a serial line or a system while they
# have it (uucplock.c, ulockf.c), and what uucico last made of calling
# each system, which would have it wait before it called again.
rm -f /usr/spool/uucp/LCK.*
rm -f /usr/spool/uucp/STST/*

# The network, as /etc/rc.conf describes it (/etc/netstart).
if [ -s /etc/rc.conf ]
then
	. /etc/rc.conf
fi
. /etc/netstart

# uucp keeps what this system sends in two directories of its spool
# named for it (subdir.c), which uucp's Makefile makes by the name the
# system has when uucp is installed; the root is made before rc.conf
# names it, so they are made here for the name it has.
n=`uuname -l | sed 's/\(.......\).*/\1/'`
for d in D.${n}X D.$n
do
	if [ ! -d /usr/spool/uucp/$d ]
	then
		mkdir /usr/spool/uucp/$d
		chmod 755 /usr/spool/uucp/$d
		chown uucp.daemon /usr/spool/uucp/$d
	fi
done

# The log, which programs write to through /dev/log and the kernel
# through /dev/klog, and /etc/syslog.conf says where each kind goes.
echo 'starting system logger'			>/dev/console 2>&1
rm -f /dev/log
syslogd

# /etc/crash should be a symbolic link to the crash directory
# if core dumps are to be saved.
if [ -d /etc/crash ]; then
	echo 'checking for core dump... '	>/dev/console 2>&1
	savecore /etc/crash			>/dev/console 2>&1
fi

echo preserving editor files			>/dev/console 2>&1
(cd /tmp; /usr/sbin/expreserve -a)
echo clearing /tmp				>/dev/console 2>&1
(cd /tmp; find . ! -name . ! -name lost+found ! -name quotas -exec rm -r {} \; )

echo -n standard daemons:			>/dev/console 2>&1
update;		echo -n ' update'		>/dev/console 2>&1
cron;		echo -n ' cron'			>/dev/console 2>&1

# accton will not start acctd if acctd.pid is corrupt or truncated (due to
# an unclean shutdown or crash).
rm -f /var/run/acctd.pid

accton /usr/adm/acct;	echo -n ' accounting'	>/dev/console 2>&1
echo '.'					>/dev/console 2>&1

# inetd, which answers telnet, ftp and the rest (/etc/inetd.conf); lpd,
# the printers' spooler (/etc/printcap), as upstream's starts it always;
# and the daemons /etc/rc.conf asks for.
echo -n starting network daemons:		>/dev/console 2>&1
if [ "${routed-NO}" = YES ]
then
	routed $routedflags; echo -n ' routed'	>/dev/console 2>&1
fi
if [ "${named-NO}" = YES ]
then
	named;	echo -n ' named'			>/dev/console 2>&1
fi
inetd;		echo -n ' inetd'		>/dev/console 2>&1
if [ "${rwhod-NO}" = YES ]
then
	rwhod;	echo -n ' rwhod'		>/dev/console 2>&1
fi
if [ "${timed-NO}" = YES ]
then
	timed $timedflags; echo -n ' timed'	>/dev/console 2>&1
fi
if [ "${ntpd-NO}" = YES ]
then
	ntpd;	echo -n ' ntpd'			>/dev/console 2>&1
fi
rm -f /dev/printer
lpd;		echo -n ' printer'		>/dev/console 2>&1
if [ "${sendmail-NO}" = YES ]
then
	(cd /usr/spool/mqueue; rm -f lf*)
	sendmail -bd -q1h; echo -n ' sendmail'	>/dev/console 2>&1
fi
echo '.'					>/dev/console 2>&1

date						>/dev/console 2>&1
exit 0
