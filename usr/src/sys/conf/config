#! /bin/sh
#	2.11BSD script to set up a new kernel configuration directory.
#
#	2026/11/27 - NST, the SCSI tapes on the Adaptec (st).
#	2026/11/23 - the 286's.  The machine's file gives the counts of the
#		     286's devices, and the kernel's Makefile is made of
#		     Make.nsunix, with the 286's Make.i286, Make.i286at and
#		     Make.i286net beside Make.sys and Make.net, and the
#		     GNUmakefile of where the system is built (Make.host).
#		     The PDP-11's parts are gone: its type, the spl
#		     scripts, boot.s, ioconf.c, the overlays, and its
#		     devices.  IDENT is not made a -D: nothing looks for
#		     it, and PC is a register's name (reg.h).
#	2026/10/30 - remove 45, 50, 53 and 55 from case PDP11
#	2026/9/11  - remove TMSCP_DEBUG (not used)
#	2026/5/15  - remove NHY
#	2026/2/28  - remove pdpmba
#       2025/08/11 - add NDHUL to specify no. of lines per DHU
#       2019/10/18 - the kernel runs on GMT.  The kernel timezone structure
#                   is obsolete, will be initialized to 0 now and only
#                   present for historical reference.
#	1997/2/14 - LINEHZ removed from localopts.h.  The clock rate is
#		    now known in _exactly 1_ place in the kernel (param.c)
#		    rather than having references scattered all over the
#		    place.  Patching 'hz' (and 'mshz') will now do the right
#		    thing (i.e. change the clock rate on the fly).
#	1996/6/8 - New spl massaging scripts.  They are now 'sed' scripts
#		   rather than 'ed' scripts and are about twice as fast.
#	1995/07/21 - remove XP_PROBE, the kernel no longer probes for disk
#		     type because that information is obtained from the
#		     disklabel.
#	2/28/95	- fixed errors introduced earlier.  remove the chmod at the
#		  end, rely instead on the system administrator's choice of
#		  umask.
#	2/14/95 - added ingres lock driver.  removed vax cruft.
#
#	1995/11/22 - added software map (SOFUB_MAP) option.

LO=../h/localopts.h

if [ $# -ne 1 ]; then
	echo "usage: $0 machinename"
	exit 1
fi

MACHINE=$1
if [ ! -s $MACHINE ]; then
	echo "$0: unable to read $MACHINE."
	exit 1
fi

# read in specification file
eval `awk '/^#/ || /^$/ || /^	/ {next} $1 != "" { printf "%s=\\"%s\\"\\n", $1, $2 }' $MACHINE`

if [ "$PDP11" ]; then
	echo "$0: $MACHINE is a PDP-11's, and this is the 286's config."
	exit 1
fi
for i in MAXUSERS LINEHZ NBUF NSLOT NWD NSD NST NFL NRD NCOM NLP NETHER NNE NSL NPTY
do
	eval v=\$$i
	if [ ! "$v" ]; then
		echo "$0: $MACHINE has no $i."
		exit 1
	fi
done
if [ "$INET" != YES ]; then
	echo "$0: the 286's kernel is made with the network: INET is YES."
	exit 1
fi

if [ ! "$TIMEZONE" ]; then
	TIMEZONE=0
fi

if [ ! "$DST" ]; then
	DST=0
fi

if [ ! "$LP_MAXCOL" ]; then
	LP_MAXCOL=132
fi

if [ ! -d ../$MACHINE ]; then
	mkdir ../$MACHINE
	echo "Creating ../$MACHINE."
	chmod 775 ../$MACHINE
fi

cat << EOF > $LO
/*
 * This file is generated by the configuration script sys/conf/config.
 *
 * It is for the kernel options that the headers themselves must see, as
 * distinct from the ones a kernel's Makefile gives the compiler as
 * -Dxxxx.  The 286's kernel has none.
 */
EOF

# Copy in the standard configuration files and makefiles.

echo "Copying standard files to ../$MACHINE."

sed	-e "s/%TIMEZONE%/$TIMEZONE/" \
	-e "s/%LINEHZ%/$LINEHZ/g" \
	-e "s/%DST%/$DST/" \
	-e "s/%NBUF%/$NBUF/" \
	-e "s/%NSLOT%/$NSLOT/" \
	-e "s/%MAXUSERS%/$MAXUSERS/" < param.c > ../$MACHINE/param.c

echo "Setting configuration options for $MACHINE."

OPTS=
if [ "$UCB_METER" = YES ]; then
	OPTS="$OPTS -DUCB_METER"
fi
if [ "$QUOTA" = YES ]; then
	OPTS="$OPTS -DQUOTA"
fi
OPTS="$OPTS -DINET"
echo "#define NLOOP	1"	> ../$MACHINE/loop.h

echo "Creating device header files."

echo "#define NCOM	$NCOM"		> ../$MACHINE/com.h
echo "#define NETHER	$NETHER"	> ../$MACHINE/ether.h
echo "#define NFL	$NFL"		> ../$MACHINE/fl.h
echo "#define NLP	$NLP"		> ../$MACHINE/lp.h
echo "#define LP_MAXCOL	$LP_MAXCOL"	>> ../$MACHINE/lp.h
echo "#define NNE	$NNE"		> ../$MACHINE/ne.h
echo "#define NPTY	$NPTY"		> ../$MACHINE/pty.h
echo "#define NRD	$NRD"		> ../$MACHINE/rd.h
echo "#define NSD	$NSD"		> ../$MACHINE/sd.h
echo "#define NSL	$NSL"		> ../$MACHINE/sl.h
echo "#define NST	$NST"		> ../$MACHINE/st.h
echo "#define NWD	$NWD"		> ../$MACHINE/wd.h

# What the code the 286 shares with the PDP-11 asks of drivers the 286
# has not.
echo "#define NIMP	0"		> ../$MACHINE/imp.h
echo "#define NINGRES	0"		> ../$MACHINE/ingres.h
echo "#define NRAM	0"		> ../$MACHINE/ram.h
echo "#define NTB	0"		> ../$MACHINE/tb.h

echo "Creating Makefile for $MACHINE".
if [ -s ../$MACHINE/Makefile ]; then
	echo "Saving ../$MACHINE/Makefile to ../$MACHINE/Makefile.old"
	cp -p ../$MACHINE/Makefile ../$MACHINE/Makefile.old
fi

echo "OPTS=$OPTS" > ../$MACHINE/Makefile

cat Make.nsunix >> ../$MACHINE/Makefile
cp Make.sys Make.i286 Make.i286at Make.net Make.i286net ../$MACHINE

# The same kernel made by GNU make where the system is built.
cp Make.host ../$MACHINE/GNUmakefile

# install copy of localopts.h and make it readable for applications
cp $LO ../$MACHINE
chmod a+r ../$MACHINE
