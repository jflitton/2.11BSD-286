#########################################################
# Networking kernel, the 286's				#
#########################################################
#
# config writes OPTS above this, and puts Make.sys, Make.i286,
# Make.i286at, Make.net and Make.i286net beside it, which compile the
# objects of their directories here.
#
#	make		the kernel, unix, and what the linker says of it,
#			unix.map
#	make install	unix is /unix, and the one that was is /unix.old,
#			to be named to /boot if this one does not start
#	make depend	what each object is made from, for make to know
#			when it is to be made again
#
# The kernel says when it was made, or what DATE is in the environment
# (../conf/newvers.sh).

H=	../h
M=	../machine
CRT=	../../lib/libc/i286/crt

# -I.. is for the headers named from there that /usr/include has not:
# pdpif/if_uba.h.
DEFS=	-DKERNEL ${OPTS} -I. -I${H} -I..
CFLAGS=	-O -mm ${DEFS}
AS=	as -mm -DFAR -I${M}/ -I${CRT}/

SUB=	sys i286 i286at net i286net

# GENERAL RULES:
# mch_start.o must be loaded first: the kernel starts at its beginning.
# The kernel's selectors are the GDT's from slot 16 (docs/boot.md), and
# its stacks are in its data (uslot, param.c).
#
# CONF	The assembly, and the long arithmetic of the C library's crt.
# BASE	The C of the kernel.  A driver whose device's count is 0 is
#	nothing.
# NETOBJ The network, which has a data segment of its own, NET_GROUP, and
#	runs on the kernel's stacks (docs/network.md): cc -nd=NET.

CONF=	mch_start.o mch_trap.o mch_copy.o mch_swtch.o mch_xxx.o mch_net.o \
	i4m.o i4d.o

BASE=	clock.o conf.o cons.o machdep.o mem.o rd.o trap.o \
	aha.o com.o fl.o kbd.o lp.o pcdisk.o sd.o vt.o wd.o \
	init_main.o init_sysent.o kern_acct.o kern_clock.o \
	kern_descrip.o kern_exec.o kern_exit.o kern_fork.o kern_mman.o \
	kern_proc.o kern_prot.o kern_prot2.o kern_resource.o kern_sig.o \
	kern_sig2.o kern_subr.o kern_synch.o kern_sysctl.o kern_time.o \
	kern_xxx.o quota_kern.o quota_subr.o quota_sys.o quota_ufs.o \
	subr_log.o subr_prf.o subr_rmap.o subr_xxx.o \
	sys_generic.o sys_inode.o sys_kern.o sys_pipe.o sys_process.o \
	syscalls.o tty.o tty_conf.o tty_pty.o tty_subr.o tty_tty.o \
	uipc_syscalls.o \
	ufs_alloc.o ufs_bio.o ufs_bmap.o ufs_disksubr.o ufs_dsort.o \
	ufs_fio.o ufs_inode.o ufs_mount.o ufs_namei.o ufs_subr.o \
	ufs_syscalls.o ufs_syscalls2.o vfs_vnops.o vm_proc.o vm_sched.o \
	vm_swap.o vm_swp.o vm_text.o

NETOBJ=	af.o if.o if_loop.o if_sl.o raw_cb.o raw_usrreq.o route.o \
	if_ether.o in.o mch_cksum.o in_pcb.o in_proto.o ip_icmp.o \
	ip_input.o ip_output.o raw_ip.o tcp_input.o tcp_output.o \
	tcp_debug.o tcp_subr.o tcp_timer.o tcp_usrreq.o udp_usrreq.o \
	net_data.o net_sys.o sys_socket.o uipc_domain.o uipc_mbuf.o \
	uipc_proto.o uipc_socket.o uipc_socket2.o uipc_usrreq.o \
	if_ne.o

KERNOBJ=${CONF} ${BASE} ${NETOBJ} vers.o param.o

all: unix

unix: ${SUB} vers.o param.o
	ld -mm -gdt 16 -stack 0 -M -o unix ${KERNOBJ} > unix.map

vers.o: FRC
	sh ../conf/newvers.sh
	${CC} ${CFLAGS} -c vers.c

param.o: param.c
	${CC} ${CFLAGS} -c param.c

sys i286 i286at:
	make -f Make.$@ AS="${AS}" CFLAGS="${CFLAGS}"

net i286net:
	make -f Make.$@ AS="${AS}" CFLAGS="${CFLAGS} -DSUPERVISOR -nd=NET"

clean:
	rm -f unix unix.map *.o vers.c

install:
	-cp /unix /unix.old
	install -c -o root -g kmem -m 744 unix /unix

depend: FRC
	for i in ${SUB}; do \
		make -f Make.$$i CFLAGS="${CFLAGS}" depend; done
	mkdep ${CFLAGS} param.c

FRC:

# DO NOT DELETE THIS LINE -- mkdep uses it.
# DO NOT PUT ANYTHING AFTER THIS LINE, IT WILL GO AWAY.
