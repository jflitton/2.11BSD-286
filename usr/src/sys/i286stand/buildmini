#!/bin/sh
#
#	@(#)buildmini	1.1 (2.11BSD) 2026/11/25
#
# Make the diskette that a machine with nothing on its disk is started
# from, after 4.3BSD's /sys/dist/buildmini and get.  It has /boot, the
# kernel and the file miniroot: a root file system that /boot loads
# into memory with the kernel, which has what it takes to label a disk,
# make a file system there and restore a dump of a root to it.
#
#	buildmini [ device ]
#
# device is the diskette's, fl0 if not given.  The diskette must be a
# formatted one (flformat) of 1.2 MB or 1.44 MB; the driver says which
# to newfs.  The miniroot is made on the diskette itself, and kept in
# /tmp while the diskette is made over.
#
miniroot=${1-fl0}
minisize=800
PATH=/bin:/sbin:/usr/sbin:/usr/ucb:/usr/bin:/etc
export PATH

date
umount /dev/${miniroot} 2> /dev/null
newfs -s `expr $minisize '*' 2` /dev/r${miniroot} || exit 1
mount /dev/${miniroot} /mnt || exit 1
cd /mnt || exit 1
mkdir bin sbin etc dev mdec mnt tmp || exit 1
chmod 1777 tmp
for i in sh cat cp dd ed ls ln mkdir mv rm chmod chgrp stty sync tar df \
	expr echo test date sed disklabel
do
	cp /bin/$i bin/$i || exit 1
done
for i in newfs mkfs restor fsck mount umount reboot mknod
do
	cp /sbin/$i sbin/$i || exit 1
done
ln sbin/reboot sbin/halt
cp /etc/init etc/init || exit 1
chmod 700 etc/init
cp /etc/disktab /etc/passwd /etc/group etc || exit 1
cp /dev/null etc/mtab
echo "/dev/rd0 / ufs rw 1 1" > etc/fstab
cp /mdec/wduboot /mdec/fluboot mdec || exit 1
ln mdec/wduboot mdec/sduboot
cat > .profile << 'EOF'
PATH=/bin:/sbin
export PATH
EOF
cp /dev/MAKEDEV dev || exit 1
(cd dev && sh MAKEDEV std wd0 wd1 sd0 sd1 fl0 fl1 ram com0) || exit 1
cd /
sync
umount /dev/${miniroot} || exit 1
fsck -y /dev/r${miniroot}
dd if=/dev/r${miniroot} of=/tmp/miniroot bs=1k count=${minisize} || exit 1

newfs /dev/r${miniroot} || exit 1
mount /dev/${miniroot} /mnt || exit 1
cp /boot /unix /tmp/miniroot /mnt || exit 1
umount /dev/${miniroot} || exit 1
rm -f /tmp/miniroot
dd if=/mdec/fluboot of=/dev/r${miniroot} count=1 || exit 1
fsck -y /dev/r${miniroot}
date
