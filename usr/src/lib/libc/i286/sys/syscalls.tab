# The C library's system call stubs, small model: tools/mkstubs.py turns
# each line into one.  NAME[=CALL] ARGUMENTS [RESULT]; the number is
# SYS_CALL in <syscall.h>.  i int, l long, p data pointer, f function
# pointer.  The Makefile has mkstubs check every line against the
# kernel's own table (sys/sys/init_sysent.c).
#
# A name beginning with an underscore is the call as the kernel has it,
# behind a function in C (this directory) that the program calls: one
# whose structure holds pointers, which are far to the kernel, or that
# does something more.
#
# Not here: recvmsg and sendmsg, whose structure needs converting the
# same way and whose kernel side is not yet written; and 2.11BSD's
# PDP-11 calls (phys, lock, fetchi, ucall, fperr, nostk).

__sysctl	pipppi
_exit=exit	i
_brk=sbrk	p
_getlogin	pi
_readv=readv	ipi
_setlogin=setlogin	p
_sigaction=sigaction	fipp
_sigaltstack=sigaltstack	pp
_sigstack=sigstack	pp
_writev=writev	ipi
