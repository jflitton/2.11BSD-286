#! /bin/sh -
# /usr/adm/monthly, which cron runs on the first of each month, mailing
# root what it prints (/etc/crontab).  Upstream's
# ../../../../usr/adm/monthly, but that it moves wtmp's older copies
# along only if they are there.
#
PATH=/usr/sbin:/usr/ucb:/bin:/usr/bin
echo "Subject: monthly run output"

echo ""
echo "Doing login accounting:"
ac -p | sort -nr +1

echo ""
echo "Rotating wtmp file:"
cd /usr/adm
for i in 5 4 3 2 1 0
do
	test -f wtmp.$i && mv wtmp.$i wtmp.`expr $i + 1`
done
mv wtmp   wtmp.0
cp /dev/null wtmp
chmod 0644 wtmp
