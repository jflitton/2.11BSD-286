#
# The terminals init runs getty on: name, command, terminal type, whether
# it is on, and whether root may log in there.  The console and ttyv1 to
# ttyv3 are the screens, which Alt-F1 to Alt-F4 choose between; tty00
# and tty01 are the serial ports COM1 and COM2.  ttyp0 to ttyp7 are the
# pseudo-terminals that telnetd logs people in on, so that utmp has them.
#
console	"/usr/libexec/getty std.9600"	pccons	on secure
ttyv1	"/usr/libexec/getty std.9600"	pccons	on secure
ttyv2	"/usr/libexec/getty std.9600"	pccons	on secure
ttyv3	"/usr/libexec/getty std.9600"	pccons	on secure
tty00	"/usr/libexec/getty std.9600"	vt100	on secure
tty01	"/usr/libexec/getty std.9600"	vt100	off secure
ttyp0	none				network	off secure
ttyp1	none				network	off secure
ttyp2	none				network	off secure
ttyp3	none				network	off secure
ttyp4	none				network	off secure
ttyp5	none				network	off secure
ttyp6	none				network	off secure
ttyp7	none				network	off secure
