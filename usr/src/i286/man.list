# The manual's pages on the system's /usr/man, which tools/mkman.py
# formats: a directory and the sources of its pages, relative to usr/src
# (docs/userland.md).  A Makefile of usr/src/man stands for the pages it
# formats, which are the 286's: in 1 and 8, those of the programs it
# has, and the introduction to each; 2, 3, 5 and 7, the kernel's calls,
# the libraries, the files and the rest, all of upstream's but a.out(5);
# 4 those not about the PDP-11's devices; 6 those of the games here;
# and no 3f, Fortran's library.  The others are of the programs, with
# their sources, and their Makefiles install them.

cat1	man/man1/Makefile
cat2	man/man2/Makefile
cat3	man/man3/Makefile
cat4	man/man4/Makefile
cat5	man/man5/Makefile
cat6	man/man6/Makefile
cat7	man/man7/Makefile
cat8	man/man8/Makefile

# With the programs' sources.
cat1	bin/chpass/chpass.1 bin/hostname/hostname.1 bin/mkdir/mkdir.1
cat1	bin/passwd/passwd.1 bin/stty/stty.1 bin/tcsh/tcsh.man bin/test/test.1
cat1	ucb/finger/finger.1 ucb/ftp/ftp.1 ucb/lock/lock.1 ucb/rlogin/rlogin.1
cat1	ucb/tftp/tftp.1 ucb/top/top.1 ucb/tset/tset.1 usr.bin/id/groups.1
cat1	usr.bin/id/id.1 usr.bin/id/whoami.1 usr.bin/patch/patch.man
cat1	usr.bin/printf/printf.1 usr.bin/shar/shar.1 usr.bin/shar/traverse.1
cat1	usr.bin/touch/touch.1 usr.bin/uname/uname.1 usr.bin/whereis/whereis.1
cat1	usr.bin/xargs/xargs.1 usr.bin/xinstall/install.1 usr.sbin/cron/crontab.1
cat1	usr.sbin/tracebuf/tracebuf.1 bin/chflags/chflags.1
cat1	ucb/mkstr/mkstr.1 usr.bin/mkerrlst/mkerrlst.1
# As the Makefile of usr/src/new installs its programs' pages.
../new/man/cat1	new/la/la.1

# This port's own editor.
cat1	i286/ve/ve.1

# The compiler and what goes with it: as and ld are the 286's own, and
# so are their pages, and ld's a.out(5).
cat1	lib/cpp/cpp.1 bin/as/i286/as.1 bin/ld/i286/ld.1
cat1	bin/ar/ar.1 usr.bin/ranlib/ranlib.1

cat3	libexec/tcpd/hosts_access.3
cat5	usr.sbin/cron/crontab.5 libexec/tcpd/hosts_access.5
cat5	libexec/tcpd/hosts_options.5 bin/disklabel/disklabel.5.5
cat5	bin/ar/ar.5.5 usr.bin/ranlib/ranlib.5.5 bin/ld/i286/a.out.5
cat6	games/atc/atc.6 games/battlestar/battlestar.6 games/hack/hack.6
cat6	games/phantasia/phant.nr:phantasia games/sail/sail.6

cat8	usr.sbin/nc/nc.1
cat8	bin/disklabel/disklabel.8 bin/ping/ping.8 bin/sysctl/sysctl.8
cat8	libexec/acctd/acctd.8 libexec/comsat/comsat.8 libexec/fingerd/fingerd.8
cat8	libexec/ftpd/ftpd.8 libexec/popper/popper.8 libexec/rexecd/rexecd.8
cat8	libexec/rlogind/rlogind.8 libexec/rshd/rshd.8 libexec/talkd/talkd.8
cat8	libexec/tcpd/tcpd.8 libexec/tcpd/tcpdchk.8 libexec/tcpd/tcpdmatch.8
cat8	libexec/telnetd/telnetd.8 libexec/tftpd/tftpd.8 sbin/badsect/badsect.8
cat8	sbin/clri/clri.8 sbin/dcheck/dcheck.8 sbin/dmesg/dmesg.8
cat8	sbin/icheck/icheck.8 sbin/ifconfig/ifconfig.8 sbin/init/init.8
cat8	sbin/mkfs/mkfs.8 sbin/mknod/mknod.8 sbin/mkpasswd/mkpasswd.8
cat8	sbin/mount/mount.8 sbin/ncheck/ncheck.8 sbin/newfs/newfs.8
cat8	sbin/reboot/reboot.8 sbin/route/route.8 sbin/shutdown/shutdown.8
cat8	sbin/umount/umount.8 usr.bin/fstat/fstat.8 usr.bin/renice/renice.8
cat8	usr.sbin/ac/ac.8 usr.sbin/accton/accton.8 usr.sbin/arp/arp.8
cat8	usr.sbin/chown/chown.8 usr.sbin/chroot/chroot.8 usr.sbin/cron/cron.8
cat8	usr.sbin/dev_mkdb/dev_mkdb.8 usr.sbin/flformat/flformat.8
cat8	usr.sbin/inetd/inetd.8
cat8	usr.sbin/makewhatis/makewhatis.8 usr.sbin/ntp/man/ntp.8
cat8	usr.sbin/ntp/man/ntpd.8 usr.sbin/ntp/man/ntpdc.8 usr.sbin/pstat/pstat.8
cat8	usr.sbin/quot/quot.8 usr.sbin/rwhod/rwhod.8 usr.sbin/sa/sa.8
cat8	usr.sbin/syslogd/syslogd.8 usr.sbin/traceroute/traceroute.8
cat8	usr.sbin/update/update.8 usr.sbin/vipw/vipw.8
cat8	share/zoneinfo/zic.8 share/zoneinfo/zdump.8
cat8	sbin/restor/restor.8
cat8	usr.sbin/rmt/rmt.8

# A page is root's and of the group staff, as upstream's Makefiles
# install them, but these, which cron's gives to bin: own, the numbers
# of the owner and the group, and the pages as /usr/man has them.
# warp's Makefile gives warp's to bin too, and man6's then installs it
# root's.
own 3.20	cat1/crontab.0 cat5/crontab.0 cat8/cron.0
