#!/usr/bin/env python3
"""Compile and link C programs for 2.11BSD on the 286, as cc(1) would.

usage: cc [-c|-E] [-o OUT] [-O] [-s] [-ms|-mm|-ml] [-Dname[=val]] [-Uname]
          [-Idir] [-Ldir] [-lname] [-stack N] [-packcode N] [-ccom]
          [-sysroot DIR] FILE ...

FILE is a C source (.c), assembly for NASM (.s, which may include the
library's DEFS.inc), an object (.o) or a library (.lib, or with -ccom
.a).  Each .c and .s is compiled; with -c that is all, each to a .o of
the same name in the current directory (or OUT, with one file).
Without -c the objects are linked into OUT, by default a.out, with the
start-up code first and the C library last, and the result made into
the system's executable format (tools/ne2aout.py,
docs/executable-format.md).

The C is compiled as the tree's expects (docs/userland.md): each
variable a file defines without a value gets common storage
(tools/commonize.py), and the compiler's own keywords that old programs
use as names, such as inline, far and interrupt, are names again.  A
variable defined twice with a value is an error.

    -E          run each .c through the preprocessor only, as it is
                compiled, and write what comes out, with #line lines,
                to the standard output; with -ccom the preprocessor is
                the system's own, /lib/cpp (tools/ncc -E), whose lines
                are "# 12 "file""
    -O          optimize; the compiler always does, for size.  -O0
                has the system's own compiler (-ccom) leave out its
                object code improver, and is nothing to the other
    -s          leave out the symbol table
    -lname      the library obj/lib/M/libname.lib, M being the model's
                letter, or libname.lib in a directory given by -L
    -stack N    the program's stack, in bytes (default 8192); execve
                adds room for the arguments and environment above it
    -ms         the small model, the default: 64K of code and 64K of
                data, stack and heap
    -mm         the medium model: far code, in as many segments as it
                takes, and the small model's data
    -ml         the large model: the medium's code, and data in as
                many segments as it takes, every pointer far, and
                malloc gets segments from the system.  The cross
                compiler makes an object of more than 32K a segment
                of its own; with -ccom every variable is in the
                program's own data
    -packcode N in the medium and large models, put the code of several
                files in one segment up to N bytes (the linker's
                default is nearly 64K)
    -local      with -ccom, name each .c to the compiler by its name
                alone, compiled in its own directory, as the system's
                Makefile for a program has cc name it (tools/ncc)
    -ccom       make the program with the system's own tools, as they
                are built for this machine (make -C usr/src/lib/ccom/i286
                host), and none of the cross compiler's: each .c
                compiled by the system's compiler (tools/ncc -O), each
                .s assembled by its assembler, and the objects, which
                are the system's own and not the cross compiler's,
                linked by its linker with the libraries made the same
                way, which are in obj/nlib and not obj/lib
    -sysroot DIR the start-up code, the C library and the others are
                those of the system's root DIR: /lib/crt0.o and
                /lib/libc.a, -lname /lib/libname.a or /usr/lib/libname.a,
                in m or l for those models, as the system's cc and ld
                find them (tools/build/build.sh).  Without -ccom they are
                the cross compiler's objects, and its libraries ar's
                archives of them, as the system's Makefiles make them
                with it

Each file is compiled for the model, and linked with its library and
start-up code, obj/lib/s, obj/lib/m or obj/lib/l.

The cross compiler's linker reads its own libraries and not ar's.  A
library that is an archive of its objects (.a), as the system's
Makefiles make one with ar where the system is built with the cross
compiler, is made one of its own when a program is linked with it: its
members put in a library by wlib, which is kept in obj/lib/ar under a
sum of the archive and made again only when that changes.

These PDP-11 flags are accepted and ignored: -i and -n (separate
instruction and data space, and shared text, which every program here
has), -z, -V, -X and -x.  Anything else beginning with -f, -w or -z is
passed to the compiler.  Needs `. tools/env.sh`.
"""
import hashlib
import os
import struct
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import commonize        # noqa: E402

TOOLS = os.path.dirname(os.path.abspath(__file__))
TOP = os.path.dirname(TOOLS)
LIBS = os.path.join(TOP, "obj", "lib")
NLIBS = os.path.join(TOP, "obj", "nlib")        # -ccom
HOST = os.path.join(TOP, "obj", "host", "ccom") # and its as and ld
CRT = os.path.join(TOP, "usr", "src", "lib", "libc", "i286", "crt")
IGNORED = {"-i", "-n", "-z", "-V", "-X", "-x", "-g"}
# Names old programs use that the compiler takes for its own: cat has a
# variable inline, which is a keyword, and getty a function interrupt,
# which the compiler predefines as a macro for __interrupt, as it does
# the others here.  The system's headers write the keywords with two
# underscores, __far and the rest, when they mean them.
# curses.h has a member _leave, one of four the compiler predefines for
# its structured exception handling.
MACROS = ["interrupt", "far", "near", "huge", "cdecl", "pascal", "fortran",
          "_leave", "_try", "_except", "_finally"]


def fail(msg):
    sys.stderr.write("cc: %s\n" % msg)
    sys.exit(1)


def run(argv):
    r = subprocess.run(argv)
    if r.returncode != 0:
        sys.exit(r.returncode)


MODEL_NAMES = {"s": "small", "m": "medium", "l": "large", "c": "compact",
               "h": "huge"}


def modules(data):
    """The object modules in an OMF file: the file, or each module of a
    library, which begins on a page boundary."""
    if not data or data[0] != 0xF0:
        yield data
        return
    page = struct.unpack_from("<H", data, 1)[0] + 3
    i = page
    while i + 3 <= len(data) and data[i] not in (0xF1, 0):
        start = i
        while i + 3 <= len(data):
            t = data[i]
            i += 3 + struct.unpack_from("<H", data, i + 1)[0]
            if t in (0x8A, 0x8B):           # MODEND
                break
        yield data[start:i]
        i = (i + page - 1) // page * page


def models_of(path):
    """The memory models the compiler recorded in an object or library:
    the second letter of its comment of class 9Bh, which reads like
    "2sO".  Assembly records none."""
    found = set()
    for mod in modules(open(path, "rb").read()):
        i = 0
        while i + 3 <= len(mod):
            t = mod[i]
            n = struct.unpack_from("<H", mod, i + 1)[0]
            body = mod[i + 3:i + 3 + n - 1]
            if t == 0x88 and len(body) >= 4 and body[1] == 0x9B:
                found.add(chr(body[3]))
            i += 3 + n
    return found


def check_model(paths, model):
    """The linker takes objects of different models together without a
    word, and the program then fails as it runs: refuse them."""
    for p in paths:
        other = models_of(p) - {model}
        if other:
            fail("%s is compiled for the %s model, not the %s" %
                 (p, MODEL_NAMES.get(min(other), min(other)),
                  MODEL_NAMES[model]))


def wlibrary(path):
    """PATH, an archive of the cross compiler's objects, as its linker's
    library, made once and kept; or PATH, if it is one already."""
    data = open(path, "rb").read()
    if data[:8] != b"!<arch>\n":
        return path
    cache = os.path.join(TOP, "obj", "lib", "ar")
    lib = os.path.join(cache, hashlib.sha256(data).hexdigest()[:24] + ".lib")
    if os.path.exists(lib):
        return lib
    import ar
    os.makedirs(cache, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix="cc286.")
    try:
        names = []
        for k, (name, member) in enumerate(ar.read(path)):
            p = os.path.join(tmp, "%d-%s" % (k, name))
            with open(p, "wb") as f:
                f.write(member)
            names.append("+" + p)
        part = "%s.%d" % (lib, os.getpid())
        r = subprocess.run(["wlib", "-q", "-n", "-b", part] + names,
                           capture_output=True, text=True)
        sys.stderr.write(r.stdout + r.stderr)
        if r.returncode != 0 or not os.path.exists(part):
            fail("%s: wlib could not make a library of it" % path)
        os.rename(part, lib)
    finally:
        for f in os.listdir(tmp):
            os.unlink(os.path.join(tmp, f))
        os.rmdir(tmp)
    return lib


def compiler_flags(cflags):
    """What every C file is compiled with, around the caller's own flags."""
    return ["-I" + os.path.join(TOP, "usr", "include")] + cflags + \
        ["-wcd=131", "-wcd=107", "-wcd=121"] + \
        ["-U" + k for k in MACROS] + ["-Dinline=inline_"]


def preprocess(src, model, cflags, ccom):
    """The preprocessor's output for SRC, to the standard output: with
    ccom, the system's own (tools/ncc -E)."""
    fd, out = tempfile.mkstemp(suffix=".i", prefix="cc286.")
    os.close(fd)
    try:
        if ccom:
            r = subprocess.run([os.path.join(TOOLS, "ncc"), "-E",
                                "-m" + model, "-o", out] + cflags + [src])
            if r.returncode != 0:
                sys.exit(1)
        else:
            r = subprocess.run([os.path.join(TOOLS, "cc286"), "-m" + model] +
                               cflags + ["-pl", "-o", out, src],
                               capture_output=True, text=True)
            msg = r.stdout + r.stderr
            sys.stderr.write(msg)
            if r.returncode != 0 or "Error!" in msg:
                sys.exit(1)
        sys.stdout.flush()
        with open(out, "rb") as f:
            sys.stdout.buffer.write(f.read())
        sys.stdout.flush()
    finally:
        os.unlink(out)


def compile_c(src, obj, model, cflags):
    """cc286, which prints the compiler's messages; an error is fatal."""
    r = subprocess.run([os.path.join(TOOLS, "cc286"), "-m" + model] + cflags +
                       ["-o", obj, src], capture_output=True, text=True)
    out = r.stdout + r.stderr
    sys.stderr.write(out)
    if r.returncode != 0 or "Error!" in out:
        try:
            os.unlink(obj)
        except OSError:
            pass
        sys.exit(1)
    commonize.commonize(obj)


def compile_ccom(src, obj, model, cflags, improve):
    """The same with the tree's compiler, which tools/ncc runs."""
    r = subprocess.run([os.path.join(TOOLS, "ncc"), "-m" + model, "-o", obj] +
                       (["-O"] if improve else []) +
                       [f for f in cflags if f[:2] in ("-D", "-U", "-I") or
                        f == "-local"] +
                       [src])
    if r.returncode != 0:
        sys.exit(1)


def main():
    args = sys.argv[1:]
    compile_only = False
    ccom = False
    improve = True
    preprocess_only = False
    out = None
    strip = False
    stack = 8192
    model = "s"
    packcode = None
    sysroot = None
    cflags = []
    libdirs = []
    files = []          # (path, kind)
    libs = []
    i = 0
    while i < len(args):
        a = args[i]
        i += 1

        def value():
            nonlocal i
            if len(a) > 2:
                return a[2:]
            if i >= len(args):
                fail("%s needs an argument" % a)
            i += 1
            return args[i - 1]

        if a == "-c":
            compile_only = True
        elif a == "-E":
            preprocess_only = True
        elif a == "-o":
            if i >= len(args):
                fail("-o needs an argument")
            out = args[i]
            i += 1
        elif a == "-O0":
            improve = False
        elif a.startswith("-O"):
            pass
        elif a == "-s":
            strip = True
        elif a == "-stack":
            if i >= len(args):
                fail("-stack needs an argument")
            stack = int(args[i], 0)
            i += 1
        elif a == "-packcode":
            if i >= len(args):
                fail("-packcode needs an argument")
            packcode = int(args[i], 0)
            i += 1
        elif a in ("-ms", "-mm", "-ml"):
            model = a[2]
        elif a == "-ccom":
            ccom = True
        elif a == "-sysroot":
            if i >= len(args):
                fail("-sysroot needs an argument")
            sysroot = args[i]
            i += 1
        elif a == "-local":
            cflags.append(a)
        elif a[:2] in ("-D", "-U", "-I"):
            v = value()
            cflags.append(a[:2] + v)
        elif a[:2] == "-L":
            libdirs.append(value())
        elif a[:2] == "-l":
            libs.append(value())
        elif a in IGNORED:
            pass
        elif a[:2] in ("-f", "-w", "-z"):
            cflags.append(a)
        elif a.startswith("-"):
            fail("unknown flag %s" % a)
        else:
            ext = os.path.splitext(a)[1]
            if ext not in (".c", ".s", ".o", ".lib", ".a"):
                fail("%s: not a .c, .s, .o or .lib" % a)
            files.append(a)
    if not files:
        sys.exit(__doc__)
    if packcode is not None and model == "s":
        fail("-packcode: the small model has one code segment")
    # what the library's assembly is told of the model (crt/DEFS.inc)
    far = {"s": [], "m": ["-DFAR"], "l": ["-DFAR", "-DFARDATA"]}[model]
    lib = os.path.join(NLIBS if ccom else LIBS, model)
    sub = {"s": "", "m": "m", "l": "l"}[model]
    if sysroot:
        lib = os.path.join(sysroot, "lib", sub)
        libdirs = libdirs + [lib, os.path.join(sysroot, "usr", "lib", sub)]
    own = cflags
    cflags = compiler_flags(cflags)
    if preprocess_only:
        for f in files:
            if f.endswith(".c"):
                preprocess(f, model, [a for a in own if a[:2] in
                                      ("-D", "-U", "-I")] if ccom else cflags,
                           ccom)
        return
    sources = [f for f in files if f.endswith((".c", ".s"))]
    if compile_only and out and len(sources) > 1:
        fail("-o with -c and more than one file")

    tmp = tempfile.mkdtemp(prefix="cc286.")
    objs = []
    # An object named again is linked once, as the system's cc has it
    # (nodup in usr/src/bin/cc.c): hack's Makefile names one in two of
    # the PDP-11's overlays.
    named = set()
    try:
        for f in files:
            if not f.endswith((".c", ".s")):
                if f.endswith(".o") and f in named:
                    continue
                named.add(f)
                objs.append(f)
                continue
            base = os.path.splitext(os.path.basename(f))[0] + ".o"
            if compile_only:
                obj = out or base
            else:
                obj = os.path.join(tmp, "%d-%s" % (len(objs), base))
            if f.endswith(".c") and ccom:
                compile_ccom(f, obj, model, own, improve)
            elif f.endswith(".c"):
                compile_c(f, obj, model, cflags)
            elif ccom:
                run([os.path.join(HOST, "as"), "-m" + model, "-I", CRT] +
                    far + ["-o", obj, f])
            else:
                # The library's conventions (crt/DEFS.inc).
                run(["nasm", "-f", "obj", "-I", CRT + "/"] + far +
                    ["-o", obj, f])
            objs.append(obj)
        if compile_only:
            return
        libpaths = []
        ext = ".a" if ccom or sysroot else ".lib"
        for name in libs:
            for d in libdirs + [lib]:
                p = os.path.join(d, "lib%s%s" % (name, ext))
                if os.path.exists(p):
                    libpaths.append(p)
                    break
            else:
                fail("no library %s" % name)
        libpaths.append(os.path.join(lib, "libc" + ext))
        out = out or "a.out"
        if ccom:
            # The system's linker, which writes the program as it is
            # to be; it says itself if a file is of another model.
            cmd = [os.path.join(HOST, "ld"), "-m" + model, "-o", out,
                   "-stack", str(stack)]
            if strip:
                cmd.append("-s")
            if packcode is not None:
                cmd += ["-packcode", str(packcode)]
            run(cmd + [os.path.join(lib, "crt0.o")] + objs + libpaths)
            return
        libpaths = [wlibrary(p) for p in
                    [o for o in objs if o.endswith(".a")] + libpaths]
        objs = [o for o in objs if not o.endswith(".a")]
        check_model(objs + libpaths, model)
        ne = os.path.join(tmp, "a.ne")
        mapf = os.path.join(tmp, "a.map")
        cmd = ["wlink", "op", "q", "format", "os2", "name", ne,
               "disable", "1014", "op",
               "nodefaultlibs,stack=%d,map=%s" % (stack, mapf)]
        if packcode is not None:
            cmd += ["op", "packcode=%d" % packcode]
        cmd += ["file", ",".join([os.path.join(lib, "crt0.o")] + objs)]
        for p in libpaths:
            cmd += ["library", p]
        r = subprocess.run(cmd, capture_output=True, text=True)
        msg = r.stdout + r.stderr
        sys.stderr.write(msg)
        # W1027 is a variable defined twice.  Uninitialized ones share
        # storage (tools/commonize.py), so this is two with values.
        if r.returncode != 0 or "Error!" in msg or "W1027" in msg or \
                not os.path.exists(ne):
            sys.exit(1)
        conv = [sys.executable, "-I", os.path.join(TOOLS, "ne2aout.py"),
                "--model", model, "--stack", str(stack)]
        if not strip:
            conv += ["--map", mapf]
        run(conv + [ne, out])
        os.chmod(out, 0o755)
    finally:
        for f in os.listdir(tmp):
            os.unlink(os.path.join(tmp, f))
        os.rmdir(tmp)


if __name__ == "__main__":
    main()
