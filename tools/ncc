#!/usr/bin/env python3
"""Compile C with the system's own compiler, run here.

usage: ncc [-E|-S] [-O] [-p] [-k] [-local] [-ms|-mm|-ml] [-nd=NAME] [-o OUT]
           [-Dname[=val]]
           [-Uname] [-Idir] FILE.c

The tree's C compiler (usr/src/lib/ccom) is two passes: c0 reads C and
writes trees, and c1, which for the 286 is usr/src/lib/ccom/i286, turns
them into assembly.  This runs the two as built for this machine
(`make -C usr/src/lib/ccom/i286 host`) and then the system's assembler,
built for it too (usr/src/bin/as/i286), on what comes out: so that the
compiler and the assembler can be worked on, and what they make linked
and run (tests/ccom), where the system is built.  With -O the assembly
goes through c2 on the way, the object code improver
(usr/src/lib/c2/i286), as cc -O has it do.

The file is first given to the system's preprocessor, /lib/cpp, built
for this machine too (usr/src/lib/cpp/i286), as cc gives it on the 286
(usr/src/bin/cc.c): told of the model, then the -D, -U and -I flags in
their order.  The directories of -I are looked in before the system's
headers, which are the tree's, usr/include.

The object is OUT, or FILE.o in the current directory.  It is one of
the system's own (a.out.h), which the system's linker links
(usr/src/bin/ld/i286, as tools/cc -ccom runs it) and the cross
compiler's linker does not.

    -E          stop before the compiler: OUT, or FILE.i, is what its
                first pass would be given to read
    -S          stop at the assembly: OUT, or FILE.s
    -O          improve the code: jumps to jumps, what is the same on
                two paths, what a register has already
    -p          count each function's calls, for prof(1), as cc -p
                has c0 told -P: the small model's alone
    -ms -mm -ml the small model, the default, or the medium, whose
                functions are far: the file's are then in a segment of
                its own, FILE_TEXT; or the large, the medium with every
                pointer far.  The preprocessor is given __MEDIUM__ for
                the medium, and for the large __LARGE__, and NULL as 0L
    -nd=NAME    the data is in NAME_DATA and NAME_BSS, of the group
                NAME_GROUP, and not the program's data segment, which is
                SS: so what is in the frame is reached through SS, as
                in the kernel's network (docs/network.md); as the cross
                compiler's -nd and -zu have it
    -k          what the kernel's Makefile gives, and the same as
                without it: the kernel's -I directories are looked in
                in their order, as every file's are
    -local      the file is named to the compiler by its name alone, as
                it is when it is compiled in its own directory: the
                name is in what assert() says
    -D -U -I    for the preprocessor

The assembly is NASM's (-S), and NASM assembles it as well: one that
makes a conditional jump to somewhere out of its reach into a jump
round a jump, which 3.0 does and the system's assembler does.  The
compiler leaves that to the assembler, as the PDP-11's does.
"""
import os
import re
import subprocess
import sys
import tempfile

TOOLS = os.path.dirname(os.path.abspath(__file__))
TOP = os.path.dirname(TOOLS)
HOST = os.path.join(TOP, "obj", "host", "ccom")
# What cc gives the preprocessor for the model.
MODEL = {"s": [], "m": ["-D__MEDIUM__"], "l": ["-D__LARGE__", "-DNULL=0L"]}


def fail(msg):
    sys.stderr.write("ncc: %s\n" % msg)
    sys.exit(1)


def main():
    args = sys.argv[1:]
    asm_only = False
    pre_only = False
    improve = False
    prof = False
    model = "s"
    out = None
    cpp = []
    src = None
    nd = None
    local = False
    kernel = False
    i = 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "-S":
            asm_only = True
        elif a == "-E":
            pre_only = True
        elif a == "-O":
            improve = True
        elif a == "-p":
            prof = True
        elif a in ("-ms", "-mm", "-ml"):
            model = a[2]
        elif a.startswith("-nd="):
            nd = a[4:]
        elif a == "-k":
            kernel = True
        elif a == "-local":
            local = True
        elif a == "-o":
            if i >= len(args):
                fail("-o needs an argument")
            out = args[i]
            i += 1
        elif a[:2] in ("-D", "-U", "-I"):
            if len(a) == 2:
                if i >= len(args):
                    fail("%s needs an argument" % a)
                a += args[i]
                i += 1
            cpp.append(a)
        elif a.startswith("-"):
            fail("unknown flag %s" % a)
        elif src:
            fail("one file at a time")
        else:
            src = a
    if not src or not src.endswith(".c"):
        sys.exit(__doc__)
    for p in ("cpp",) + (() if pre_only else ("c0", "c1")) + \
            (("c2",) if improve and not pre_only else ()) + \
            (() if asm_only or pre_only else ("as",)):
        if not os.path.exists(os.path.join(HOST, p)):
            fail("no obj/host/ccom/%s: make -C usr/src/lib/ccom/i286 host" % p)
    base = os.path.splitext(os.path.basename(src))[0]
    out = out or base + (".i" if pre_only else ".s" if asm_only else ".o")

    tmp = tempfile.mkdtemp(prefix="ncc.")
    try:
        # The preprocessor, as cc runs it: what it is told of the
        # model first (usr/src/bin/cc.c), then the flags.
        # -local: the file is named as `cc -c file.c` in its own
        # directory names it.
        here = None
        name = src
        if local and os.path.dirname(src):
            here, name = os.path.split(os.path.abspath(src))
            cpp = ["-I" + os.path.abspath(a[2:]) if a[:2] == "-I" else a
                   for a in cpp]
        r = subprocess.run([os.path.join(HOST, "cpp")] + MODEL[model] +
                           cpp + [name], capture_output=True, cwd=here)
        sys.stderr.write(r.stderr.decode("latin-1"))
        if r.returncode != 0:
            sys.exit(1)
        # A file is named as it is on the system, where the tree's
        # usr/src is /usr/src: the name is in what assert() says, and
        # the system, making the same file from its own /usr/src
        # (docs/self-hosting.md), is to make the same of it.  And c0
        # has 64 characters for a name.
        text = r.stdout.replace(b'"' + TOP.encode() + b"/", b'"/')
        pre = out if pre_only else os.path.join(tmp, base + ".i")
        with open(pre, "wb") as f:
            f.write(text)
        if pre_only:
            return
        t1 = os.path.join(tmp, "t1")
        t2 = os.path.join(tmp, "t2")
        asm = out if asm_only else os.path.join(tmp, base + ".s")
        # The medium model's code is in a segment for each file, which
        # is named for the file, as the cross compiler's is.
        seg = re.sub(r"[^A-Za-z0-9_]", "_", base) + "_TEXT"
        if seg[0].isdigit():
            seg = "_" + seg
        # c0 and c1 are told -M for the medium model, and -L for the
        # large.
        flag = {"s": None, "m": "-M", "l": "-L"}[model]
        raw = os.path.join(tmp, "t3") if improve else asm
        passes = [[os.path.join(HOST, "c0"), pre, t1, t2] +
                  (["-P"] if prof else []) +
                  ([flag] if flag else []) + (["-S"] if nd else []),
                  [os.path.join(HOST, "c1"), t1, t2, raw] +
                  ([flag + seg] if flag else []) +
                  (["-N" + nd] if nd else [])]
        if improve:
            passes.append([os.path.join(HOST, "c2"), raw, asm])
        for cmd in passes:
            r = subprocess.run(cmd, capture_output=True, text=True)
            msg = r.stdout + r.stderr
            # A message begins with the line it is about, and the file
            # too if the preprocessor has said which it is.
            for m in msg.splitlines():
                sys.stderr.write("%s:%s\n" % (src, m) if m[:1].isdigit()
                                 else m + "\n")
            if r.returncode != 0:
                if asm_only and os.path.exists(asm):
                    os.unlink(asm)
                sys.exit(1)
        if not asm_only:
            r = subprocess.run([os.path.join(HOST, "as"), "-m" + model,
                                "-o", out, asm])
            if r.returncode != 0:
                sys.exit(1)
    finally:
        for f in os.listdir(tmp):
            os.unlink(os.path.join(tmp, f))
        os.rmdir(tmp)


if __name__ == "__main__":
    main()
